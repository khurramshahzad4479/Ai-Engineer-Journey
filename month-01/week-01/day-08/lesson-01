{"Name" : "Ayaan",
"Marks" : 83,
"Course": "Python"}]

with open("students.jason", "w", encoding="utf-8")as file:
    json.dump(students, file, indent=4)

with open("students.jason", "r", encoding="utf-8")as file:
    students_data = json.load(file)

# Find the highest scorer using max() and a lambda function
highest_scorer = max(students_data, key=lambda s: s["Marks"])
print("Highest Scorer :", highest_scorer)

"""Create a function which load students from JSON and return highest scorer
Function ka naam:
def get_highest_scorer(filename: str) -> dict:"""


def get_highest_scorer(filename: str) -> dict:
    with open(filename, "r") as file:
        students = json.load(file)
    return max(students, key=lambda s: s["Marks"])